{
  "$comment": "Figma 变量名 → CSS 变量名 的命名规则表。gen-tokens.py 读取本文件生成 tokens.css / tokens.json / references/tokens.md。改这里而不是改生成物。",
  "schema": "vibeme.token-map/v1",
  "cssVarPrefix": "--vm-",
  "collections": {
    "Variable collection": { "mode": "leaf", "prefix": "" },
    "Color Panel": { "mode": "leaf", "prefix": "" },
    "总组件库 / Foundations": { "mode": "leaf", "prefix": "" },
    "VibeMe AI / Primitives": { "mode": "full", "prefix": "ai-" },
    "VibeMe AI / Dimensions": { "mode": "full", "prefix": "ai-" },
    "VibeMe AI / Semantic": { "mode": "full", "prefix": "ai-" },
    "Collection": { "mode": "leaf", "prefix": "" }
  },
  "overrides": {
    "状态色/Error": "status-error",
    "状态色/Success": "status-success",
    "状态色/Warning": "status-warning",
    "状态色/Info": "status-info",
    "border/width/thin": "border-width-thin",
    "border/width/thick": "border-width-thick",
    "border/width/ring": "border-width-ring",
    "focus/ring-width": "focus-ring-width",
    "opacity/disabled": "opacity-disabled",
    "opacity/muted": "opacity-muted",
    "opacity/full": "opacity-full",
    "duration/fast": "duration-fast",
    "duration/normal": "duration-normal",
    "duration/slow": "duration-slow",
    "Semantic Space/padding-card-sm": "padding-card-sm",
    "Semantic Space/padding-card-md": "padding-card-md",
    "Semantic Space/padding-card-lg": "padding-card-lg"
  },
  "legacy": [
    "Color",
    "Color 3",
    "Color 4",
    "button",
    "按钮",
    "分割线",
    "绿色",
    "标注色-1",
    "标注用色",
    "100%",
    "100",
    "后台主色",
    "主色/Main Orange",
    "Text/灰/Black",
    "Text/灰/Gray1",
    "Text/灰/深灰",
    "Text/灰/中灰",
    "Text/灰/浅灰",
    "Text/灰/边框灰",
    "Text/灰/666",
    "Text/辅助色",
    "Text/副标题、正文"
  ],
  "legacyReason": "历史遗留命名：或与主体系语义重复（Text/灰/*、Text/辅助色、Text/副标题、正文），或命名错误（主色/Main Orange 的值其实是品牌砂色 #FFCC90），或与产品无关（Color 3/4、后台主色、绿色、按钮、分割线、标注用色）。写出新代码时一律不要引用，一律走主体系 token。",
  "groups": [
    { "id": "brand", "name": "品牌色 Brand", "match": ["^Brand/"] },
    { "id": "text", "name": "文字 Text", "match": ["^Text/Text-"] },
    { "id": "surface", "name": "背景与表面 Surface", "match": ["^Background/", "^Scrim/"] },
    { "id": "border", "name": "描边与聚焦 Border / Focus", "match": ["^border/", "^focus/"] },
    { "id": "neutral", "name": "中性色阶 Neutral", "match": ["^Neutral/", "^White/", "^Black/"] },
    { "id": "status", "name": "状态色 Status", "match": ["^状态色/"] },
    { "id": "space", "name": "间距与内边距 Space", "match": ["^space/", "^Semantic Space/"] },
    { "id": "radius", "name": "圆角 Radius", "match": ["^Radious/", "^Semantic Radius/"] },
    { "id": "size", "name": "组件尺寸 Component Size", "match": ["^Modal Size/"] },
    { "id": "opacity", "name": "不透明度 Opacity", "match": ["^opacity/"] },
    { "id": "motion", "name": "动效 Motion", "match": ["^duration/"] },
    { "id": "palette", "name": "扩展色板 Color Panel（主库未使用，备用）", "collections": ["Color Panel"] },
    { "id": "ai", "name": "VibeMe AI 主题（另一套 token，不要与主库混用）", "collections": ["VibeMe AI / Primitives", "VibeMe AI / Dimensions", "VibeMe AI / Semantic"] }
  ],
  "fontFamily": "\"Poppins\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
  "fontWeights": {
    "Thin": 100,
    "ExtraLight": 200,
    "Extra Light": 200,
    "Light": 300,
    "Regular": 400,
    "Medium": 500,
    "SemiBold": 600,
    "Semi Bold": 600,
    "Bold": 700,
    "ExtraBold": 800,
    "Extra Bold": 800,
    "Black": 900
  },
  "licenseNote": "Poppins 采用 SIL Open Font License 1.1，可随产品分发；中文回退 PingFang SC / Microsoft YaHei 由系统提供。"
}
